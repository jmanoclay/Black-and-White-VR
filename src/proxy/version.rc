// The game checks the DirectX version with DSETUP's DirectXSetupGetVersion, which reads the file
// version of the ddraw.dll it finds first -- this proxy. Without a version resource the game
// refuses to start ("You need DirectX 7 or greater"). Mirror the Windows 11 system ddraw.dll.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 10,0,26100,8115
 PRODUCTVERSION 10,0,26100,8115
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Black & White VR mod"
            VALUE "FileDescription", "ddraw.dll proxy (Black & White VR mod)"
            VALUE "FileVersion", "10.0.26100.8115"
            VALUE "InternalName", "ddraw"
            VALUE "OriginalFilename", "ddraw.dll"
            VALUE "ProductName", "Black & White VR mod"
            VALUE "ProductVersion", "10.0.26100.8115"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
