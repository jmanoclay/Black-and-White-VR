{
  "controller_type": "oculus_touch",
  "name": "Black & White VR - Oculus Touch / Quest controllers",
  "description": "Default bindings for Oculus Touch and Quest controllers (A/B on the right, X/Y on the left)",
  "action_manifest_version": 0,
  "bindings": {
    "/actions/god": {
      "poses": [
        {
          "output": "/actions/god/in/aim",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/god/in/aim",
          "path": "/user/hand/right/pose/tip"
        },
        {
          "output": "/actions/god/in/grip_pose",
          "path": "/user/hand/left/pose/raw"
        },
        {
          "output": "/actions/god/in/grip_pose",
          "path": "/user/hand/right/pose/raw"
        }
      ],
      "haptics": [
        {
          "output": "/actions/god/out/haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/god/out/haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "skeleton": [
        {
          "output": "/actions/god/in/skeleton_left",
          "path": "/user/hand/left/input/skeleton/left"
        },
        {
          "output": "/actions/god/in/skeleton_right",
          "path": "/user/hand/right/input/skeleton/right"
        }
      ],
      "sources": [
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/god/in/trigger"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/god/in/trigger"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/god/in/squeeze"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/god/in/squeeze"
            }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/god/in/a"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/god/in/a"
            }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/god/in/b"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/god/in/b"
            }
          }
        },
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/god/in/stick"
            },
            "click": {
              "output": "/actions/god/in/stick_click"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/god/in/stick"
            },
            "click": {
              "output": "/actions/god/in/stick_click"
            }
          }
        }
      ]
    }
  }
}