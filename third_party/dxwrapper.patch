+extern bool g_DxwFastDraw;  // (bwvr: ddraw.cpp)
+extern bool g_DxwRingDraw;
+
+// bwvr: the indexed draws' vertices and indices appended to dynamic buffers of our own (no
+// overwrite until they wrap, then discard), drawn with DrawIndexedPrimitive, in place of
+// DrawIndexedPrimitiveUP. False: draw it the usual way.
+namespace
+{
+	struct RingBuffers
+	{
+		IDirect3DDevice9* owner = nullptr;
+		IDirect3DVertexBuffer9* vb = nullptr;
+		IDirect3DIndexBuffer9* ib = nullptr;
+		UINT vpos = 0, ipos = 0;
+		static constexpr UINT kVB = 32u << 20, kIB = 8u << 20;  // (an eye's vertices over the village: ~4.5 MB)
+		// (DxwRingFill: a block of vertices and indices put in the buffers ahead, in one lock each;
+		// draws whose arrays lie inside it draw from there without copying.)
+		const BYTE* pre_v = nullptr;
+		const BYTE* pre_i = nullptr;
+		UINT pre_vbytes = 0, pre_ibytes = 0, pre_vpos = 0, pre_ipos = 0;
+	} g_Ring;
+
+	bool RingDraw(IDirect3DDevice9* dev, D3DPRIMITIVETYPE type, const void* vertices, UINT stride, UINT minIndex, UINT numVerts, const WORD* indices, UINT indexCount, UINT primCount, HRESULT& hr)
+	{
+		RingBuffers& r = g_Ring;
+		if (r.owner != dev)
+		{
+			if (r.vb) r.vb->Release();
+			if (r.ib) r.ib->Release();
+			r = RingBuffers{};
+			if (FAILED(dev->CreateVertexBuffer(RingBuffers::kVB, D3DUSAGE_DYNAMIC | D3DUSAGE_WRITEONLY, 0, D3DPOOL_DEFAULT, &r.vb, nullptr)) ||
+				FAILED(dev->CreateIndexBuffer(RingBuffers::kIB, D3DUSAGE_DYNAMIC | D3DUSAGE_WRITEONLY, D3DFMT_INDEX16, D3DPOOL_DEFAULT, &r.ib, nullptr)))
+			{
+				if (r.vb) r.vb->Release();
+				r = RingBuffers{};
+				return false;
+			}
+			r.owner = dev;
+		}
+		const UINT vbytes = numVerts * stride, ibytes = indexCount * sizeof(WORD);
+		// Arrays already in the buffers (DxwRingFill): no copy, no lock.
+		const BYTE* v = static_cast<const BYTE*>(vertices) + size_t(minIndex) * stride;
+		const BYTE* ix = reinterpret_cast<const BYTE*>(indices);
+		if (r.pre_v && v >= r.pre_v && v + vbytes <= r.pre_v + r.pre_vbytes && ix >= r.pre_i && ix + ibytes <= r.pre_i + r.pre_ibytes &&
+			(r.pre_vpos + UINT(v - r.pre_v)) % stride == 0)
+		{
+			dev->SetStreamSource(0, r.vb, 0, stride);
+			dev->SetIndices(r.ib);
+			hr = dev->DrawIndexedPrimitive(type, INT((r.pre_vpos + UINT(v - r.pre_v)) / stride) - INT(minIndex), minIndex, numVerts,
+				(r.pre_ipos + UINT(ix - r.pre_i)) / sizeof(WORD), primCount);
+			return true;
+		}
+		if (vbytes > RingBuffers::kVB / 4 || ibytes > RingBuffers::kIB / 4) return false;
+		UINT vpos = (r.vpos + stride - 1) / stride * stride;
+		DWORD vflags = D3DLOCK_NOOVERWRITE;
+		if (vpos + vbytes > RingBuffers::kVB) vpos = 0, vflags = D3DLOCK_DISCARD;
+		DWORD iflags = D3DLOCK_NOOVERWRITE;
+		UINT ipos = r.ipos;
+		if (ipos + ibytes > RingBuffers::kIB) ipos = 0, iflags = D3DLOCK_DISCARD;
+		if (r.pre_v && (vflags == D3DLOCK_DISCARD || iflags == D3DLOCK_DISCARD)) return false;  // (a wrap would lose the block put ahead)
+		void* p = nullptr;
+		if (FAILED(r.vb->Lock(vpos, vbytes, &p, vflags)) || !p) return false;
+		memcpy(p, static_cast<const BYTE*>(vertices) + size_t(minIndex) * stride, vbytes);
+		r.vb->Unlock();
+		p = nullptr;
+		if (FAILED(r.ib->Lock(ipos, ibytes, &p, iflags)) || !p) return false;
+		memcpy(p, indices, ibytes);
+		r.ib->Unlock();
+		dev->SetStreamSource(0, r.vb, 0, stride);
+		dev->SetIndices(r.ib);
+		// (Index i is vertex i - minIndex of what was copied: the base makes that line up.)
+		hr = dev->DrawIndexedPrimitive(type, INT(vpos / stride) - INT(minIndex), minIndex, numVerts, ipos / sizeof(WORD), primCount);
+		r.vpos = vpos + vbytes, r.ipos = ipos + ibytes;
+		return true;
+	}
+}
+
+// bwvr: puts a block of vertices (aligned for `stride`) and indices in the buffers ahead, in one
+// lock each; draws whose arrays lie inside the given ranges then draw from there. A null block
+// ends it (before the arrays are reused). False if it can't (no buffers yet, too big).
+extern "C" BOOL WINAPI DxwRingFill(const void* vertices, UINT vbytes, UINT stride, const void* indices, UINT ibytes)
+{
+	RingBuffers& r = g_Ring;
+	r.pre_v = r.pre_i = nullptr, r.pre_vbytes = r.pre_ibytes = 0;
+	if (!vertices || !indices || !r.vb || !r.ib || !stride || vbytes > RingBuffers::kVB / 2 || ibytes > RingBuffers::kIB / 2) return FALSE;
+	UINT vpos = (r.vpos + stride - 1) / stride * stride;
+	DWORD vflags = D3DLOCK_NOOVERWRITE;
+	if (vpos + vbytes > RingBuffers::kVB) vpos = 0, vflags = D3DLOCK_DISCARD;
+	UINT ipos = r.ipos;
+	DWORD iflags = D3DLOCK_NOOVERWRITE;
+	if (ipos + ibytes > RingBuffers::kIB) ipos = 0, iflags = D3DLOCK_DISCARD;
+	void* p = nullptr;
+	if (FAILED(r.vb->Lock(vpos, vbytes, &p, vflags)) || !p) return FALSE;
+	memcpy(p, vertices, vbytes);
+	r.vb->Unlock();
+	p = nullptr;
+	if (FAILED(r.ib->Lock(ipos, ibytes, &p, iflags)) || !p) return FALSE;
+	memcpy(p, indices, ibytes);
+	r.ib->Unlock();
+	r.pre_v = static_cast<const BYTE*>(vertices), r.pre_vbytes = vbytes, r.pre_vpos = vpos;
+	r.pre_i = static_cast<const BYTE*>(indices), r.pre_ibytes = ibytes, r.pre_ipos = ipos;
+	r.vpos = vpos + vbytes, r.ipos = ipos + ibytes;
+	return TRUE;
+}
