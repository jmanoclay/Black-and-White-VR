+
+// BW VR mod: the Direct3D 9 device and surface behind a DirectDraw surface, so the mod can copy
+// a render target into a texture shared with Direct3D 11 (for SteamVR) without a CPU readback.
+// The pointers are not AddRef'd: they stay valid while the DirectDraw surface and device live.
+// bwvr: the per-draw savings in IDirect3DDeviceX (textures left bound, states set only when they
+// change) on or off, for timing them against the original in the same view.
+bool g_DxwFastDraw = true;
+bool g_DxwRingDraw = true;  // (bwvr: DrawIndexedPrimitive from our own dynamic buffers; DxwSetFastDraw bit 2)
+extern "C" void WINAPI DxwSetFastDraw(BOOL on)
+{
+	g_DxwFastDraw = (on & 1) != 0;
+	g_DxwRingDraw = (on & 2) != 0;
+}
+
+extern "C" HRESULT WINAPI DxwGetD3D9Surface(LPDIRECTDRAWSURFACE7 lpSurface, LPDIRECT3DDEVICE9* ppDevice, LPDIRECT3DSURFACE9* ppSurface)
+{
+	if (!lpSurface || !ppDevice || !ppSurface)
+	{
+		return E_INVALIDARG;
+	}
+	m_IDirectDrawSurfaceX* lpSurfaceX = nullptr;
+	lpSurface->QueryInterface(IID_GetInterfaceX, (LPVOID*)&lpSurfaceX);
+	if (!lpSurfaceX || !lpSurfaceX->GetDDrawParent())
+	{
+		return E_NOINTERFACE;
+	}
+	ScopedCriticalSection ThreadLockDD(DdrawWrapper::GetDDCriticalSection());
+	LPDIRECT3DDEVICE9* lpDevice = lpSurfaceX->GetDDrawParent()->GetDirectD9Device();
+	LPDIRECT3DSURFACE9 lpD9Surface = lpSurfaceX->GetD9Surface();
+	if (!lpDevice || !*lpDevice || !lpD9Surface)
+	{
+		return E_FAIL;
+	}
+	*ppDevice = *lpDevice;
+	*ppSurface = lpD9Surface;
+	return S_OK;
+}
